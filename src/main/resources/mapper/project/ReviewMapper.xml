<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.project.mapper.ReviewMapper">

    <resultMap id="BaseResultMap" type="cn.staitech.anno.project.domain.Review">
            <id property="reviewId" column="review_id" jdbcType="BIGINT"/>
            <result property="score" column="score" jdbcType="BIGINT"/>
            <result property="details" column="details" jdbcType="VARCHAR"/>
            <result property="reviewPeople" column="review_people" jdbcType="VARCHAR"/>
            <result property="reviewTime" column="review_time" jdbcType="TIMESTAMP"/>
            <result property="slideId" column="slide_id" jdbcType="BIGINT"/>
            <result property="reviewContent" column="review_content" jdbcType="VARCHAR"/>
            <result property="reviewRound" column="review_round" jdbcType="BIGINT"/>
            <result property="topicId" column="topic_id" jdbcType="BIGINT"/>
            <result property="topicName" column="topic_name" jdbcType="VARCHAR"/>
            <result property="groupId" column="group_id" jdbcType="BIGINT"/>
            <result property="groupName" column="group_name" jdbcType="VARCHAR"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="projectId" column="project_id" jdbcType="BIGINT"/>
            <result property="projectName" column="project_name" jdbcType="VARCHAR"/>
            <result property="roundId" column="round_id" jdbcType="BIGINT"/>
            <result property="roundName" column="round_name" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="exportReview" parameterType="Map" resultType="cn.staitech.anno.project.vo.ReviewVO">
        select r.*,p.project_name,i.image_code
        from tb_review r
            left join tb_project p on r.project_id = p.project_id
            left join tb_slide s on r.slide_id = s.slide_id
            left join tb_image i on s.image_id = i.image_id
        <where>
            <if test="params.projectId!= null">
                AND s.project_id = #{params.projectId}
            </if>
            <if test="params.slideId!= null">
                AND s.slide_id = #{params.slideId}
            </if>
        </where>
    </select>


    <select id="selectSlide" parameterType="long" resultType="cn.staitech.anno.project.domain.Review">
        SELECT
            s.slide_id,
            i.image_name AS slide_name,
            p.project_id,
            p.project_name,
            g.group_id,
            g.group_name,
            t.topic_id,
            t.topic_name,
            r.round_id,
            r.round_name,
            group_concat( st.NAME SEPARATOR "/" ) AS review_content
        FROM
            tb_slide AS s
            LEFT JOIN tb_project AS p ON s.project_id = p.project_id
            LEFT JOIN tb_group AS g ON g.group_id = s.group_id
            LEFT JOIN tb_topic AS t ON t.topic_id = p.topic_id
            LEFT JOIN tb_round AS r ON r.round_id = s.round_id
            LEFT JOIN tb_image AS i ON i.image_id = s.image_id
            LEFT JOIN tb_pathological_indicator AS ind ON ind.indicator_id = p.indicator_id
            LEFT JOIN tb_pathological_indicator_category AS cate ON cate.indicator_id = ind.indicator_id
            LEFT JOIN tb_structure AS st ON st.structure_id = cate.structure_id
        <where>
            <if test="slideId !=  null">
                AND s.slide_id = #{slideId}
            </if>
        </where>
    </select>

</mapper>
