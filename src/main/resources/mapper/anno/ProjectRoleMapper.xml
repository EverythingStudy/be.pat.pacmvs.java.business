<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.ProjectRoleMapper">
    <resultMap type="cn.staitech.system.api.domain.SysProjectRole" id="SysProjectRoleResult">
        <id property="roleId" column="role_id"/>
        <result property="projectId" column="project_id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleType" column="role_type"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectProjectRoleVo">
        select distinct role_id,
                        project_id,
                        role_name,
                        role_type,
                        status,
                        del_flag,
                        create_by,
                        create_time,
                        update_by,
                        update_time
        from sys_project_role
    </sql>

    <select id="selectProjectRoleList" parameterType="cn.staitech.system.api.domain.SysProjectRole"
            resultMap="SysProjectRoleResult">
        <include refid="selectProjectRoleVo"/>
        where del_flag = '0'
        <if test="roleId != null and roleId != 0">
            AND role_id = #{roleId}
        </if>
        <if test="projectId != null and projectId != 0">
            AND project_id = #{projectId}
        </if>
        <if test="roleType != null and roleType != 0">
            AND role_type = #{roleType}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        order by role_type
    </select>

    <select id="selectProjectRole" parameterType="java.lang.Long" resultMap="SysProjectRoleResult">
        <include refid="selectProjectRoleVo"/>
        where del_flag = '0'
        <if test="roleId != null and roleId != 0">
            AND role_id = #{roleId}
        </if>
    </select>

    <select id="countProjectRole" parameterType="cn.staitech.system.api.domain.SysProjectRole"
            resultType="java.lang.Integer">
        select count(1) from sys_project_role
        where del_flag = '0'
        <if test="roleId != null and roleId != 0">
            AND role_id = #{roleId}
        </if>
        <if test="projectId != null and projectId != 0">
            AND project_id = #{projectId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        order by role_type , role_id
    </select>


    <insert id="insertProjectRole" parameterType="cn.staitech.system.api.domain.SysProjectRole" useGeneratedKeys="true"
            keyProperty="roleId">
        insert into sys_project_role(
        <if test="projectId != null and projectId != ''">
            project_id,
        </if>
        <if test="roleName != null and roleName != ''">
            role_name,
        </if>
        <if test="roleType != null and roleType != ''">
            role_type,
        </if>
        <if test="status != null and status != ''">
            status,
        </if>
        <if test="delFlag != null and delFlag != ''">
            del_flag,
        </if>
        <if test="createBy != null and createBy != ''">
            create_by,
        </if>
        create_time,
        <if test="updateBy != null and updateBy != ''">
            update_by,
        </if>
        update_time
        )values(
        <if test="projectId != null and projectId != ''">
            #{projectId},
        </if>
        <if test="roleName != null and roleName != ''">
            #{roleName},
        </if>
        <if test="roleType != null and roleType != ''">
            #{roleType},
        </if>
        <if test="status != null and status != ''">
            #{status},
        </if>
        <if test="delFlag != null and delFlag != ''">
            #{delFlag},
        </if>
        <if test="createBy != null and createBy != ''">
            #{createBy},
        </if>
        sysdate(),
        <if test="updateBy != null and updateBy != ''">
            #{updateBy},
        </if>
        sysdate()
        )
    </insert>


    <update id="updateProjectRole" parameterType="cn.staitech.system.api.domain.SysProjectRole">
        update sys_project_role
        <set>
            <if test="projectId != null and projectId != ''">
                project_id = #{projectId},
            </if>
            <if test="roleName != null and roleName != ''">
                role_name = #{roleName},
            </if>
            <if test="roleType != null and roleType != ''">
                role_type = #{roleType},
            </if>
            <if test="status != null and status != ''">
                status = #{status},
            </if>
            <if test="delFlag != null and delFlag != ''">
                del_flag = #{delFlag},
            </if>
            <if test="createBy != null and createBy != ''">
                create_by = #{createBy},
            </if>
            create_time = sysdate(),
            <if test="updateBy != null and updateBy != ''">
                update_by = #{updateBy},
            </if>
            update_time = sysdate()
        </set>
        where role_id = #{roleId}
    </update>

    <delete id="deleteProjectRoleById" parameterType="Long">
        update sys_role
        set del_flag = '1'
        where role_id = #{roleId}
    </delete>

    <delete id="deleteProjectRoleByIds" parameterType="Long">
        update sys_role set del_flag = '1' where role_id in
        <foreach collection="array" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <select id="selectByProjectId" parameterType="java.lang.Long" resultMap="SysProjectRoleResult">
        select *
        from sys_project_role
        where project_id = #{ProjectId,jdbcType=BIGINT}
    </select>
</mapper>