    <sql id="statisticSelectAnnotationSql">
        AND a.category_id != 1
        <if test="organizationId !=null and organizationId !=0">
            AND a.organization_id =#{organizationId}
        </if>
        <if test="startTime != null and startTime != ''">
            <!-- 开始时间检索 -->
            AND date_format(a.update_time,'%Y-%m-%d') &gt;= date_format(#{startTime},'%Y-%m-%d')
        </if>
        <if test="endTime != null and endTime != ''">
            <!-- 结束时间检索 -->
            AND date_format(a.update_time,'%Y-%m-%d') &lt;= date_format(#{endTime},'%Y-%m-%d')
        </if>
        <if test="projectIdList != null and projectIdList.size() >0 ">
            AND a.project_id IN
            <foreach collection="projectIdList" item="projectId" open="(" separator="," close=")">
                #{projectId}
            </foreach>
        </if>
        <if test="indicatorIdList != null and indicatorIdList.size() >0 ">
            AND a.project_id IN
            (
            SELECT
            p.project_id
            FROM
            tb_project as p
            WHERE
            indicator_id IN
            <foreach collection="indicatorIdList" item="indicatorId" open="(" separator="," close=")">
                #{indicatorId}
            </foreach>
            )
        </if>
        <if test="categoryIdList != null and categoryIdList.size() >0">
            AND a.category_id IN
            <foreach collection="categoryIdList" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
        <if test="userIdList != null and userIdList.size() >0 ">
            AND a.create_by IN
            <foreach collection="userIdList" item="createBy" open="(" separator="," close=")">
                #{createBy}
            </foreach>
        </if>
        <if test="slideIdList != null and slideIdList.size() >0 ">
            AND a.slide_id IN
            <foreach collection="slideIdList" item="slideId" open="(" separator="," close=")">
                #{slideId}
            </foreach>
        </if>
        <!--<if test="examinationFlag != null and examinationFlag == 45 or examinationFlag == 46 or examinationFlag == 47 ">
            AND a.slide_id IN (
            <if test="examinationFlag == 45 ">&#45;&#45; 图像标注完成
                SELECT s.slide_id FROM tb_slide as s WHERE s.process_flag = 2
            </if>
            <if test="examinationFlag == 46 ">&#45;&#45; 图像复核通过
                SELECT s.slide_id FROM tb_slide as s WHERE s.examination_flag = 2
            </if>
            <if test="examinationFlag == 47 ">&#45;&#45; 图像交付
                SELECT s.slide_id FROM tb_slide as s WHERE s.examination_flag = 4
            </if>
            )
        </if>-->

        <if test="examinationFlag != null and examinationFlag != ''">
            AND a.slide_id IN (
            SELECT s.slide_id FROM tb_slide as s WHERE s.status = #{examinationFlag})
        </if>
    </sql>

    <sql id="statisticSelectImageSql">
        <if test="startTime != null and startTime != ''">
            <!-- 开始时间检索 -->
            AND date_format(s.create_time,'%Y-%m-%d') &gt;= date_format(#{startTime},'%Y-%m-%d')
        </if>
        <if test="endTime != null and endTime != ''">
            <!-- 结束时间检索 -->
            AND date_format(s.create_time,'%Y-%m-%d') &lt;= date_format(#{endTime},'%Y-%m-%d')
        </if>
        <if test="projectIdList != null and projectIdList.size() >0 ">
            AND s.project_id IN
            <foreach collection="projectIdList" item="projectId" open="(" separator="," close=")">
                #{projectId}
            </foreach>
        </if>
        <if test="indicatorIdList != null and indicatorIdList.size() >0 ">
            AND s.project_id IN
            (
            SELECT
            p.project_id
            FROM
            tb_project AS p
            WHERE
            p.indicator_id IN
            <foreach collection="indicatorIdList" item="indicatorId" open="(" separator="," close=")">
                #{indicatorId}
            </foreach>
            )
        </if>
        <if test="categoryIdList != null and categoryIdList.size() >0">
            AND s.slide_id IN
            (
            SELECT
            a.slide_id
            FROM
            tb_annotation AS a
            WHERE a.category_id IN
            <foreach collection="categoryIdList" item="categoryIdId" open="(" separator="," close=")">
                #{categoryIdId}
            </foreach>
            )
        </if>
        <if test="userIdList != null and userIdList.size() >0 ">
