    <!--综合统计列表：标注数量-项目-->
    <select id="statisticSelectAnnoProjectList" parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO"
            resultMap="StatisticResult">
        SELECT
        a.project_id,
        p.project_name,
        count(a.marking_id) as annotation_count
        FROM
        tb_marking as a
        inner join tb_project as p on a.project_id = p.project_id
        <where>
            <include refid="statisticSelectAnnotationSql"/>
        </where>
        GROUP BY a.project_id,project_name
        order by a.project_id desc
    </select>

    <!--综合统计列表：标注数量-病理指标-->
    <select id="statisticSelectAnnoIndicatorList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        pi.indicator_id,
        pi.indicator_name,
        count(a.marking_id) as annotation_count
        FROM
        tb_marking AS a
        INNER JOIN tb_project AS p ON a.project_id = p.project_id
        INNER JOIN tb_pathological_indicator AS pi ON pi.indicator_id = p.indicator_id
        <where>
            <include refid="statisticSelectAnnotationSql"/>
        </where>
        GROUP BY pi.indicator_id, pi.indicator_name
        order by pi.indicator_id desc
    </select>

    <!--综合统计列表：标注数量-标注类别-->
    <select id="statisticSelectAnnoCategoryList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        pic.category_id,
        pic.category_name,
        count(a.marking_id) as annotation_count
        FROM
        tb_marking AS a
        left JOIN tb_pathological_indicator_category AS pic ON a.category_id = pic.category_id
        <where>
            <include refid="statisticSelectAnnotationSql"/>
        </where>
        GROUP BY pic.category_id, pic.category_name
        order by pic.category_id desc
    </select>

    <!--综合统计列表：标注数量-成员-->
    <select id="statisticSelectMemberList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT a.create_by,
        u.user_name,
        count(a.marking_id) AS annotation_count
        FROM tb_marking AS a
        LEFT JOIN sys_user u ON a.create_by = u.user_id
        <where>
            <include refid="statisticSelectAnnotationSql"/>
        </where>
        GROUP BY a.create_by
        ORDER BY a.create_by DESC
    </select>

    <!--综合统计列表：标注数量-图像-->
    <select id="statisticSelectAnnoImageList" parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO"
            resultMap="StatisticResult">
        SELECT
        i.image_id,
        i.image_name,
        count(a.marking_id) as annotation_count
        FROM
        tb_marking AS a
        INNER JOIN tb_image AS i ON a.image_id = i.image_id
        <where>
            <include refid="statisticSelectAnnotationSql"/>
        </where>
        GROUP BY i.image_id, i.image_name
        order by i.image_id desc
    </select>

