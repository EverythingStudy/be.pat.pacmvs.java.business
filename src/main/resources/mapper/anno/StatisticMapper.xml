    <!--综合统计列表：图像数量-项目-->
    <select id="statisticSelectImageProjectList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        p.project_id,
        p.project_name,
        count(s.slide_id) as image_count
        FROM
        tb_slide AS s
        INNER JOIN tb_project AS p ON s.project_id = p.project_id
        <where>
            <if test="organizationId !=null and organizationId !=0">
                and p.organization_id =#{organizationId}
            </if>
            <include refid="statisticSelectImageSql"/>
        </where>
        GROUP BY p.project_id, p.project_name
        order by p.project_id desc
    </select>

    <!--综合统计列表：图像数量-病理指标-->
    <select id="statisticSelectImageIndicatorList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        pi.indicator_id,
        pi.indicator_name,
        count(s.slide_id) as image_count
        FROM
        tb_slide AS s
        INNER JOIN tb_project AS p ON s.project_id = p.project_id
        INNER JOIN tb_pathological_indicator AS pi ON pi.indicator_id = p.indicator_id
        <where>
            <if test="organizationId !=null and organizationId !=0">
                and p.organization_id =#{organizationId}
            </if>
            <include refid="statisticSelectImageSql"/>
        </where>
        GROUP BY pi.indicator_id, pi.indicator_name
        order by pi.indicator_id desc
    </select>

    <!--综合统计列表：图像数量-标注类别-->
    <select id="statisticSelectImageCategoryList"
            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        pic.category_id,
        pic.category_name,
        pic.indicator_id,
        count(
        DISTINCT ( a.slide_id )) image_count
        FROM
        tb_marking a
        LEFT JOIN tb_slide s ON s.slide_id = a.slide_id
        LEFT JOIN tb_pathological_indicator_category pic ON a.category_id = pic.category_id
        <where>
            <if test="organizationId !=null and organizationId !=0">
                and a.organization_id =#{organizationId}
            </if>
            <include refid="statisticSelectImageSql"/>
        </where>
        GROUP BY
        a.category_id
        ORDER BY
        a.category_id DESC
    </select>

