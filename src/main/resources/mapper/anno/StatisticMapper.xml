            parameterType="cn.staitech.anno.domain.vo.statistic.StatisticListInVO" resultMap="StatisticResult">
        SELECT
        s.create_by,
        u.user_name,
        count(DISTINCT s.slide_id ) image_count
        FROM
        `tb_slide` s
        LEFT JOIN sys_user u ON u.user_id = s.create_by
        LEFT JOIN tb_project p ON p.project_id = s.project_id
        LEFT JOIN tb_pathological_indicator pi ON pi.indicator_id = p.indicator_id
        LEFT JOIN tb_pathological_indicator_category pic ON pic.indicator_id = pi.indicator_id
        <where>
            <if test="organizationId !=null and organizationId !=0">
                and p.organization_id =#{organizationId}
            </if>
            <include refid="statisticSelectImageSql"/>
        </where>
        GROUP BY
        s.create_by
        ORDER BY
        s.create_by DESC
    </select>

