<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.SysOrganizationMapper">
    <resultMap type="cn.staitech.system.domain.SysOrganization" id="SysOrganizationResult">
        <result property="organizationId" column="organization_id"/>
        <result property="organizationName" column="organization_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="phonenumber" column="phonenumber"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap type="cn.staitech.system.domain.vo.organization.OrganizationSelectResVo" id="OrganizationResult">
        <result property="organizationId" column="organization_id"/>
        <result property="organizationName" column="organization_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="phonenumber" column="phonenumber"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createTime" column="create_time"/>
        <result property="authorizationMemberLimit" column="authorization_member_limit"/>
        <result property="authorizationMemberUsed" column="authorization_member_used"/>
        <result property="authorizationImageLimit" column="authorization_image_limit"/>
        <result property="authorizationImageUsed" column="authorization_image_used"/>
        <result property="authorizationTime" column="authorization_time"/>
        <result property="expirationTime" column="expiration_time"/>
    </resultMap>

    <resultMap type="cn.staitech.anno.domain.organization.OrganizationIdName" id="organizationMap">
        <result property="organizationId" column="organization_id"/>
        <result property="organizationName" column="organization_name"/>
    </resultMap>

    <sql id="selectBy">
        select organization_id
             , organization_name
             , contact_name
             , phonenumber
             , status
             , del_flag
             , create_by
             , create_time
             , update_by
             , update_time
        from sys_organization
    </sql>

    <!--查询组织表IdNameList-->
    <select id="selectIdNameList" resultMap="organizationMap">
        select distinct organization_id, organization_name
        from sys_organization
        order by organization_id asc;
    </select>
</mapper>
