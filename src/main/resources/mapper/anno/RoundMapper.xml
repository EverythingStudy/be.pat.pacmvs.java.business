<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.RoundMapper">
    <resultMap type="cn.staitech.anno.domain.round.Round" id="RundResult">
        <result property="roundId" column="round_id"/>
        <result property="roundName" column="round_name"/>
    </resultMap>

    <sql id="selectList">
        select round_id, round_name
        from tb_round
    </sql>
</mapper>