    <sql id="selectMarking">
        select marking_id
             , slide_id
             , annotation_id
             , area
             , perimeter
             , measure_full_name
             , measure_type
             , measure_relation
             , measure_name
             , measure_number
             , radius
             , mean_distance
             , max_distance
             , min_distance
             , inner_angle
             , exterior_angle
             , center_point
             , annotation_type
             , location_type
             , create_by
             , create_time
             , point_count
        from tb_marking
    </sql>

    <sql id="selectBy">
        SELECT t.annotation_type,
               t.marking_id,
               t.area,
               t.perimeter,
               t.description,
               t.category_id,
               t.measure_type,
               t.measure_relation,
               t.measure_name,
               t.measure_number,
               t.radius,
               t.mean_distance,
               t.max_distance,
               t.min_distance,
               t.inner_angle,
               t.exterior_angle,
               t.create_by,
               t.create_time,
               t.location_type,
               t.slide_id,
               t.center_point,
               t.point_count,
               t.annotation_owner,
               c.rgb                                                             as label_color,
               c.category_name                                                   as label_name,
               CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name) as measure_full_name,
               t.annotation_owner,
               t.annotation_update_owner,
               t.update_time,
               t.update_by,
               t.image_id,
               t.project_id,
               t.image_url
        FROM tb_marking AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>

    <sql id="selectPoint">
        SELECT DISTINCT CONCAT_WS("_", t.measure_name, t1.category_name) as measure_full_name,
                        t.point_count
        FROM tb_marking AS t
                 LEFT JOIN tb_pathological_indicator_category AS t1 ON t.category_id = t1.category_id
    </sql>

    <sql id="selectList">
        SELECT annotation_id,
               geometry,
               JSON_OBJECT(
                       "annotation_type",
                       t.annotation_type,
                       "area",
                       t.area,
                       "perimeter",
                       t.perimeter,
                       "measure_type",
                       t.measure_type,
                       "measure_relation",
                       t.measure_relation,
                       "measure_name",
                       t.measure_name,
                       "measure_number",
                       t.measure_number,
                       "radius",
                       t.radius,
                       "mean_distance",
                       t.mean_distance,
                       "max_distance",
                       t.max_distance,
                       "min_distance",
                       t.min_distance,
                       "inner_angle",
                       t.inner_angle,
                       "exterior_angle",
                       t.exterior_angle,
                       "create_time",
                       DATE_FORMAT(t.create_time, '%Y-%m-%d %H:%i:%s'),
                       "center_point",
                       t.center_point,
                       "annotation_owner",
                       cast(t.create_by as char(200)),
                       "label_color",
                       c.rgb,
                       "label_code",
                       c.number,
                       "number",
                       t.number,
                       "label_name",
                       c.category_name,
                       "measure_full_name",
                       CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name)
                   ) AS properties
        FROM tb_marking AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>

    <sql id="selectListBy">
        SELECT annotation_id,
