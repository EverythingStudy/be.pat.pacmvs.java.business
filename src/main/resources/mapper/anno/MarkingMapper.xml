    <update id="updatePointCount" parameterType="cn.staitech.anno.domain.marking.Marking" useGeneratedKeys="true"
            keyProperty="marking_id">
        update tb_marking
        <set>
            point_count = #{point_count}
        </set>
        where category_id = #{category_id}
        AND slide_id = #{slide_id}
        AND location_type = 'Point'
    </update>
