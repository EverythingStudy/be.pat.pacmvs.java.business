    <sql id="selectMarking">
        select marking_id
             , slide_id
             , annotation_id
             , area
             , perimeter
             , measure_full_name
             , measure_type
             , measure_relation
             , measure_name
             , measure_number
             , radius
             , mean_distance
             , max_distance
             , min_distance
             , inner_angle
             , exterior_angle
             , center_point
             , annotation_type
             , location_type
             , create_by
             , create_time
             , point_count
        from tb_marking
    </sql>

    <sql id="selectBy">
        SELECT
            t.marking_id,
            t.annotation_id,
            t.area,
            t.perimeter,
            CONCAT_WS( "_", CONCAT( t.measure_name, t.number ), t1.category_name ) AS measure_full_name,
            t.description,
            t.category_id,
            t.measure_type,
            t.measure_name,
            t.measure_number,
            t.radius,
            t.mean_distance,
            t.max_distance,
            t.min_distance,
            t.inner_angle,
            t.exterior_angle,
            u.user_name,
            t.create_time,
            t.center_point,
            t.point_count,
            t.GEOMETRY,
            t1.category_name
        FROM
            tb_marking AS t
                LEFT JOIN tb_pathological_indicator_category AS t1 ON t.category_id = t1.category_id
                LEFT JOIN sys_user AS u ON u.user_id = t.create_by
    </sql>

    <sql id="selectPoint">
        SELECT DISTINCT
            CONCAT_WS( "_", t.measure_name, t1.category_name ) as measure_full_name,
            t.point_count
        FROM
            tb_marking AS t
                LEFT JOIN tb_pathological_indicator_category AS t1 ON t.category_id = t1.category_id
    </sql>

    <select id="selectBy" parameterType="long" resultMap="propertiesResult">
        <include refid="selectBy"/>
        where marking_id = #{markingId}
    </select>


    <select id="selectList" parameterType="Long" resultMap="markingSelectListVoResult">
        <include refid="selectBy"/>
        where slide_id = #{slideId}
        AND location_type != "Point"
        ORDER BY marking_id DESC
    </select>

    <select id="selectPointCountList" parameterType="long" resultMap="markingSelectListVoResult">
        <include refid="selectPoint"/>
        where slide_id = #{slideId}
        AND location_type = "Point"
    </select>

    <select id="selectSlideList" parameterType="Long" resultMap="slideResult">
        SELECT s.slide_id,
               sub.image_name
        FROM tb_special AS spe
                 LEFT JOIN tb_project AS p ON spe.special_id = p.special_id
                 LEFT JOIN tb_slide AS s ON s.project_id = p.project_id
                 LEFT JOIN tb_sub_image AS sub ON s.image_id = sub.image_id
        WHERE spe.special_id = #{specialId}
          AND p.del_flag = 0
          AND s.is_delete = 0
    </select>

    <select id="selectCategoryCountList" parameterType="Long" resultMap="pointCountResult">
        SELECT category_id,
               count(marking_id) AS point_count
        FROM tb_marking
        WHERE slide_id = #{slideId}
          AND location_type = "Point"
        GROUP BY category_id
    </select>

    <select id="selectCategoryCount" parameterType="cn.staitech.anno.domain.marking.Marking"
            resultMap="pointCountResult">
        SELECT
        category_id,
        count( marking_id ) AS point_count
        FROM
        tb_marking
        WHERE
        location_type = "Point"
        <if test="slide_id != null">
            AND slide_id = #{slide_id}
        </if>
        <if test="category_id != null">
            AND category_id = #{category_id}
        </if>
    </select>

