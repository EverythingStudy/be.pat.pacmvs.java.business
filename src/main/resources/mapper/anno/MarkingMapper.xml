                       "min_distance",
                       t.min_distance,
                       "inner_angle",
                       t.inner_angle,
                       "exterior_angle",
                       t.exterior_angle,
                       "create_by",
                       t.create_by,
                       "create_time",
                       DATE_FORMAT(t.create_time, '%Y-%m-%d %H:%i:%s'),
                       "location_type",
                       t.location_type,
                       "slide_id",
                       t.slide_id,
                       "center_point",
                       t.center_point,
                       "point_count",
                       t.point_count,
                       "annotation_owner",
                       t.annotation_owner,
                       "label_color",
                       c.rgb,
                       "label_code",
                       c.number,
                       "number",
                       t.number,
                       "label_name",
                       c.category_name,
                       "measure_full_name",
                       CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name),
                       "image_id",
                       t.image_id,
                       "project_id",
                       t.project_id,
                       "image_url",
                       t.image_url
                   ) AS properties
        FROM tb_marking AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>

    <select id="selectListBy" parameterType="long" resultMap="featuresResult">
        <include refid="selectListBy"/>
        where slide_id = #{slideId}
    </select>


    <select id="selectBy" parameterType="string" resultMap="propertiesResult">
        <include refid="selectBy"/>
        where marking_id = #{markingId}
    </select>

    <select id="selectMeasureList" parameterType="long" resultMap="propertiesResult">
        <include refid="selectBy"/>
        where
        t.slide_id = #{slideId}
        AND t.location_type != "Point"
    </select>


    <select id="jsonExportSelect" parameterType="long" resultMap="jsonExportResult">
        SELECT t.topic_name,
               p.project_id,
               p.project_name,
               pi.species_id,
               pi.organ_id,
               i.file_name                       as image_name,
               i.format,
               i.image_url,
               p.indicator_id,
               s.create_time,
               CONCAT_WS(',', i.width, i.height) AS image_shape
        FROM tb_slide AS s
                 LEFT JOIN tb_project AS p ON p.project_id = s.project_id
                 LEFT JOIN tb_review_round AS re on re.review_round_id = s.review_round_id
                 LEFT JOIN tb_topic AS t ON t.topic_id = re.topic_id
                 LEFT JOIN tb_image AS i ON i.image_id = s.image_id
                 LEFT JOIN tb_pathological_indicator as pi on pi.indicator_id = p.indicator_id
        WHERE s.slide_id = #{slideId}
    </select>

    <select id="reviewJsonExportSelect" parameterType="long" resultMap="jsonExportResult">
        SELECT t.topic_name,
               p.project_id,
               p.project_name,
               pi.species_id,
               pi.organ_id,
               i.file_name                       as image_name,
               i.format,
               i.image_url,
               p.indicator_id,
               s.create_time,
               CONCAT_WS(',', i.width, i.height) AS image_shape
        FROM tb_slide AS s
                 LEFT JOIN tb_project AS p ON p.project_id = s.project_id
                 LEFT JOIN tb_topic AS t ON t.topic_id = s.topic_id
                 LEFT JOIN tb_image AS i ON i.image_id = s.image_id
                 LEFT JOIN tb_pathological_indicator as pi on pi.indicator_id = p.indicator_id
        WHERE s.slide_id = #{slideId}
    </select>


    <select id="selectLists" parameterType="long" resultMap="featuresResult">
        <include refid="selectList"/>
        where slide_id = #{slideId}
    </select>


    <select id="selectList" parameterType="long" resultMap="markingSelectListVoResult">
        <include refid="selectBy"/>
        where slide_id = #{slideId}
        AND location_type != "Point"
        ORDER BY marking_id DESC
    </select>

    <select id="selectPointCountList" parameterType="long" resultMap="markingSelectListVoResult">
        <include refid="selectPoint"/>
        where slide_id = #{slideId}
        AND location_type = "Point"
    </select>

    <select id="selectSlideList" parameterType="long" resultMap="slideResult">
        SELECT s.slide_id,
               sub.image_name
        FROM tb_special AS spe
                 LEFT JOIN tb_project AS p ON spe.special_id = p.special_id
                 LEFT JOIN tb_slide AS s ON s.project_id = p.project_id
                 LEFT JOIN tb_sub_image AS sub ON s.image_id = sub.image_id
        WHERE spe.special_id = #{specialId}
          AND p.del_flag = 0
          AND s.is_delete = 0
    </select>

    <select id="selectCategoryCountList" parameterType="long" resultMap="pointCountResult">
        SELECT category_id,
               count(marking_id) AS point_count
        FROM tb_marking
        WHERE slide_id = #{slideId}
          AND location_type = "Point"
        GROUP BY category_id
    </select>

    <select id="selectCategoryCount" parameterType="cn.staitech.anno.domain.marking.Marking"
            resultMap="pointCountResult">
        SELECT
        category_id,
        count( marking_id ) AS point_count
        FROM
        tb_marking
        WHERE
        location_type = "Point"
        <if test="slide_id != null">
            AND slide_id = #{slide_id}
        </if>
        <if test="category_id != null">
            AND category_id = #{category_id}
        </if>
    </select>

