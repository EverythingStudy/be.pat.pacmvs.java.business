    <!-- 通用查询结果列 -->
    <!-- <sql id="Base_Column_List">
        mark_measure_id, annotation_id, project_id, slide_id, area, perimeter, description, category_id, number, measure_type, 
        measure_relation, measure_name, measure_number, mean_distance, max_distance, min_distance, inner_angle, exterior_angle, 
        center_point, location_type, point_count, radius, geometry, create_by, create_time, update_by, update_time, annotation_owner,
        annotation_update_owner, organization_id,annotation_type
    </sql> -->
    
    <select id="selectListCount" parameterType="long" resultType="int">
        SELECT count(*) * 1
        FROM tb_mark_measure AS t
        LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
        where slide_id = #{slideId}
        AND location_type != "Point"
        <if test="measureFullName != null and measureFullName != ''">
            and CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name) LIKE concat('%', #{measureFullName}, '%')
        </if>
    </select>
    
    
    <select id="selectPointCountList" parameterType="map" resultMap="markingSelectListVoResult">
        SELECT DISTINCT CONCAT_WS("_", t.measure_name, t1.category_name) as measure_full_name,
                        t.point_count
        FROM tb_mark_measure AS t
                 LEFT JOIN tb_pathological_indicator_category AS t1 ON t.category_id = t1.category_id
        where slide_id = #{slideId}
        <if test="measureFullName != null and measureFullName != ''">
            AND CONCAT_WS("_", t.measure_name, t1.category_name) LIKE concat('%', #{measureFullName}, '%')
        </if>
        AND location_type = "Point"
    </select>
    
    <sql id="selectBy">
        SELECT t.annotation_type,
               <!-- t.mark_measure_id as marking_id, -->
               t.mark_measure_id,
               t.area,
               t.perimeter,
               t.description,
               t.category_id,
               t.measure_type,
               t.measure_relation,
               t.measure_name,
               t.measure_number,
               t.radius,
               t.mean_distance,
               t.max_distance,
               t.min_distance,
               t.inner_angle,
               t.exterior_angle,
               t.create_by,
               t.create_time,
               t.location_type,
               t.slide_id,
               t.center_point,
               t.point_count,
               t.annotation_owner,
               c.rgb                                                             as label_color,
               c.category_name                                                   as label_name,
               CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name) as measure_full_name,
               t.annotation_owner,
               t.annotation_update_owner,
               t.update_time,
               t.update_by,
           --    t.image_id,
               t.project_id
--                t.image_url
        FROM tb_mark_measure AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>
    
    <select id="selectList" parameterType="long" resultMap="markingSelectListVoResult">
        <include refid="selectBy"/>
        where slide_id = #{slideId}
        AND location_type != "Point"
        <if test="measureFullName != null and measureFullName != ''">
            and CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name) LIKE concat('%', #{measureFullName}, '%')
        </if>
        ORDER BY mark_measure_id DESC
        limit #{pageNum},#{pageSize}
    </select>
    
    
    <sql id="selectListBy">
        SELECT annotation_id,
               geometry,
               JSON_OBJECT(
                       "annotation_type",
                       t.annotation_type,
                       "marking_id",
                       t.mark_measure_id,
                       "area",
                       t.area,
                       "perimeter",
                       t.perimeter,
                       "description",
                       t.description,
                       "category_id",
                       t.category_id,
                       "measure_type",
                       t.measure_type,
                       "measure_relation",
                       t.measure_relation,
                       "measure_name",
                       t.measure_name,
                       "measure_number",
                       t.measure_number,
                       "radius",
                       t.radius,
                       "mean_distance",
                       t.mean_distance,
                       "max_distance",
                       t.max_distance,
                       "min_distance",
                       t.min_distance,
                       "inner_angle",
                       t.inner_angle,
                       "exterior_angle",
                       t.exterior_angle,
                       "create_by",
                       t.create_by,
                       "create_time",
                       DATE_FORMAT(t.create_time, '%Y-%m-%d %H:%i:%s'),
                       "location_type",
                       t.location_type,
                       "slide_id",
                       t.slide_id,
                       "center_point",
                       t.center_point,
                       "point_count",
                       t.point_count,
                       "annotation_owner",
                       t.annotation_owner,
                       "label_color",
                       c.rgb,
                       "label_code",
                       c.number,
                       "number",
                       t.number,
                       "label_name",
                       c.category_name,
                       "measure_full_name",
                       CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name),
                      -- "image_id",
                     --  t.image_id,
                       "update_by",
                       t.update_by,
                       "annotation_update_owner",
                       t.annotation_update_owner,
                       "project_id",
                       t.project_id
--                    ,
--                        "image_url",
--                        t.image_url
                   ) AS properties
        FROM tb_mark_measure AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>
    
    <select id="selectListBy" parameterType="long" resultMap="featuresResult">
        <include refid="selectListBy"/>
        where slide_id = #{slideId}
    </select>
    
    <select id="selectBy" parameterType="string" resultMap="propertiesResult">
        <include refid="selectBy"/>
        where mark_measure_id = #{markingId}
    </select>
    
    <select id="selectCategoryCount" parameterType="cn.staitech.anno.vo.marking.Marking"
            resultMap="pointCountResult">
        SELECT
        category_id,
        count( mark_measure_id ) AS point_count
        FROM
        tb_mark_measure
        WHERE
        location_type = "Point"
        <if test="slide_id != null">
            AND slide_id = #{slide_id}
        </if>
        <if test="category_id != null">
            AND category_id = #{category_id}
        </if>
    </select>
    
    
    <update id="updatePointCount" parameterType="cn.staitech.anno.vo.marking.Marking" useGeneratedKeys="true"
            keyProperty="mark_measure_id">
        update tb_mark_measure
        <set>
            point_count = #{point_count}
        </set>
        where category_id = #{category_id}
        AND slide_id = #{slide_id}
        AND location_type = 'Point'
    </update>
    
    <insert id="delete" parameterType="java.lang.String">
        delete
        from tb_mark_measure
        where mark_measure_id = #{markingId}
    </insert>
    
    <select id="selectMeasureList" parameterType="long" resultMap="propertiesResult">
        <include refid="selectBy"/>
        where
        t.slide_id = #{slideId}
        AND t.location_type != "Point"
    </select>
    
    <sql id="selectList">
        SELECT annotation_id,
               geometry,
               JSON_OBJECT(
                       "annotation_type",
                       t.annotation_type,
                       "area",
                       t.area,
                       "perimeter",
                       t.perimeter,
                       "measure_type",
                       t.measure_type,
                       "measure_relation",
                       t.measure_relation,
                       "measure_name",
                       t.measure_name,
                       "measure_number",
                       t.measure_number,
                       "radius",
                       t.radius,
                       "mean_distance",
                       t.mean_distance,
                       "max_distance",
                       t.max_distance,
                       "min_distance",
                       t.min_distance,
                       "inner_angle",
                       t.inner_angle,
                       "exterior_angle",
                       t.exterior_angle,
                       "create_time",
                       DATE_FORMAT(t.create_time, '%Y-%m-%d %H:%i:%s'),
                       "center_point",
                       t.center_point,
                       "annotation_owner",
                       cast(t.create_by as char(200)),
                       "label_color",
                       c.rgb,
                       "label_code",
                       c.number,
                       "number",
                       t.number,
                       "label_name",
                       c.category_name,
                       "measure_full_name",
                       CONCAT_WS("_", CONCAT(t.measure_name, t.number), c.category_name)
                   ) AS properties
        FROM tb_mark_measure AS t
                 LEFT JOIN tb_pathological_indicator_category AS c ON t.category_id = c.category_id
    </sql>
    
    <select id="selectLists" parameterType="long" resultMap="featuresResult">
        <include refid="selectList"/>
        where slide_id = #{slideId}
    </select>
    
    
    <select id="jsonExportSelect" parameterType="long" resultMap="jsonExportResult">
        SELECT t.topic_name,
               p.project_id,
               p.project_name,
               pi.species_id,
               pi.organ_id,
               i.file_name                       as image_name,
               i.format,
               i.image_url,
               p.indicator_id,
               s.create_time,
               CONCAT_WS(',', i.width, i.height) AS image_shape
        FROM tb_slide AS s
                 LEFT JOIN tb_project AS p ON p.project_id = s.project_id
                 LEFT JOIN tb_review_round AS re on re.review_round_id = s.review_round_id
                 LEFT JOIN tb_topic AS t ON t.topic_id = re.topic_id
                 LEFT JOIN tb_image AS i ON i.image_id = s.image_id
                 LEFT JOIN tb_pathological_indicator as pi on pi.indicator_id = p.indicator_id
        WHERE s.slide_id = #{slideId}
    </select>
    
    
    <select id="reviewJsonExportSelect" parameterType="long" resultMap="jsonExportResult">
        SELECT t.topic_name,
               p.project_id,
               p.project_name,
               pi.species_id,
               pi.organ_id,
               i.file_name                       as image_name,
               i.format,
               i.image_url,
               p.indicator_id,
               s.create_time,
               CONCAT_WS(',', i.width, i.height) AS image_shape
        FROM tb_slide AS s
                 LEFT JOIN tb_project AS p ON p.project_id = s.project_id
                 LEFT JOIN tb_topic AS t ON t.topic_id = s.topic_id
                 LEFT JOIN tb_image AS i ON i.image_id = s.image_id
                 LEFT JOIN tb_pathological_indicator as pi on pi.indicator_id = p.indicator_id
        WHERE s.slide_id = #{slideId}
    </select>

</mapper>
