<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.AlgorithmJsonMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.staitech.anno.domain.AlgorithmJson">
        <id column="algorithm_json_id" property="algorithmJsonId" />
        <result column="algorithm_assessment_id" property="algorithmAssessmentId" />
        <result column="slide_id" property="slideId" />
        <result column="algorithm_json_name" property="algorithmJsonName" />
        <result column="algorithm_json_url" property="algorithmJsonUrl" />
        <result column="selected_status" property="selectedStatus" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
        <result column="del_flag" property="delFlag" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        algorithm_json_id, algorithm_assessment_id, slide_id, algorithm_json_name, algorithm_json_url, selected_status, create_by, create_time, update_by, update_time, del_flag
