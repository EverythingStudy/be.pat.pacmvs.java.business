<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.OrganMapper">
    <resultMap type="cn.staitech.anno.domain.Organ" id="OrganResult">
        <result property="organId" column="organ_id"/>
        <result property="name" column="name"/>
        <result property="nameEn" column="name_en"/>
        <result property="speciesCode" column="species_code"/>
        <result property="organizationId" column="organization_id"/>
    </resultMap>

    <select id="getOrganBySpeciesId" parameterType="java.lang.String"
            resultType="cn.staitech.anno.domain.Organ">
        SELECT organ_id,`name`,`name_en`,species_code
        FROM tb_organ
        <where>
            <if test="speciesId != null">
                species_code = #{speciesCode,jdbcType=VARCHAR}
            </if>
        </where>
    </select>
</mapper>