<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.SpecialRoleUserMapper">

    <resultMap type="cn.staitech.anno.domain.special.SpecialRoleUser" id="SpecialRoleMenuResult">
        <result property="roleId" column="role_id"/>
        <result property="userId" column="user_id"/>
        <result property="specialId" column="special_id"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap type="cn.staitech.anno.domain.vo.special.SpecialRoleUserSelectResVo" id="SelectListResult">
        <result property="userCode" column="user_code"/>
        <result property="userName" column="user_name"/>
        <result property="userId" column="user_id"/>
        <result property="roleId" column="role_id"/>
        <result property="nickName" column="nick_name"/>
        <result property="sex" column="sex"/>
        <result property="phonenumber" column="phonenumber"/>
        <result property="roleName" column="role_name"/>
        <result property="specialRoleName" column="special_role_name"/>
        <result property="specialRoleId" column="special_role_id"/>
        <result property="organizationName" column="organization_name"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectList">
        select u.user_code,
               u.user_id,
               u.role_id,
               u.user_name,
               u.nick_name,
               u.sex,
               u.phonenumber,
               r.role_name,
               sr.role_name as special_role_name,
               sr.role_id   as special_role_id,
               org.organization_name,
               s.status,
               s.create_time
        from tb_special_role_user as s
                 left join sys_user as u on u.user_id = s.user_id
                 left join sys_organization as org on u.organization_id = org.organization_id
                 left join sys_role as r on u.role_id = r.role_id
                 left join tb_special_role as sr on sr.role_id = s.role_id
    </sql>

    <sql id="select">
        select user_id,
               role_id,
               special_id,
               status,
               create_by,
               create_time,
               update_by,
               update_time
        from tb_special_role_user
    </sql>

    <select id="selectUserSpecialBy" parameterType="cn.staitech.anno.domain.vo.special.SpecialSelectByIn"
            resultMap="SelectListResult">
        <include refid="selectList"/>
        <where>
            u.del_flag = 0
            <if test="userId != null and userId != 0">
                AND u.user_id = #{userId}
            </if>
            <if test="specialId != null and specialId != 0">
                AND s.special_id = #{specialId}
            </if>
        </where>
        LIMIT 1
    </select>

    <select id="selectUserId" parameterType="java.lang.Long"
            resultMap="SpecialRoleMenuResult">
        <include refid="select"/>
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
        </where>
    </select>

    <select id="querySpecialRoleListByUserId" parameterType="java.lang.Long" resultMap="SpecialRoleMenuResult">
        SELECT sru.user_id,
               sru.special_id,
               sru.role_id,
               sr.role_name
        FROM tb_special_role_user sru
                 LEFT JOIN tb_special_role sr ON sru.role_id = sr.role_id
        WHERE sru.user_id = #{userId}
        ORDER BY sru.special_id;
    </select>

    <select id="querySpecialRoleListByAdmin" resultMap="SpecialRoleMenuResult">
        SELECT special_id
        FROM tb_special
    </select>


    <select id="selectList" parameterType="cn.staitech.anno.domain.vo.special.SpecialRoleUserSelectVo"
            resultMap="SelectListResult">
        <include refid="selectList"/>
        <where>
            u.del_flag = 0
            <if test="userName != null and userName != ''">
                AND u.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="nickName != null and nickName != ''">
                AND u.nick_name like concat('%', #{nickName}, '%')
            </if>
            <if test="phonenumber != null and phonenumber != ''">
                AND u.phonenumber like concat('%', #{phonenumber}, '%')
            </if>
            <if test="specialRoleId != null and specialRoleId != ''">
                AND sr.role_id = #{specialRoleId}
            </if>
            <if test="roleId != null and roleId != ''">
                AND r.role_id = #{roleId}
            </if>
            <if test="status != null">
                AND s.status = #{status}
            </if>
            <if test="createTimeParams != null">
                <if test="createTimeParams.beginTime != null and createTimeParams.beginTime != ''">
                    AND date_format(s.create_time,'%y%m%d') &gt;= date_format(#{createTimeParams.beginTime},'%y%m%d')
                </if>
                <if test="createTimeParams.endTime != null and createTimeParams.endTime != '' ">
                    AND date_format(s.create_time,'%y%m%d') &lt;= date_format(#{createTimeParams.endTime},'%y%m%d')
                </if>
            </if>
            <if test="specialId != null and specialId != 0">
                AND s.special_id = #{specialId}
            </if>
        </where>
        order by s.create_time desc
    </select>

    <select id="select" parameterType="cn.staitech.anno.domain.special.SpecialRoleUser"
            resultMap="SpecialRoleMenuResult">
        <include refid="select"/>
        <where>
            <if test="userId != null and userId != 0">
                user_id = #{userId}
            </if>
            <if test="roleId != null and roleId != 0">
                AND role_id = #{roleId}
            </if>
            <if test="specialId != null and specialId != 0">
                AND special_id = #{specialId}
            </if>
        </where>
        LIMIT 1
    </select>

    <insert id="insert" parameterType="cn.staitech.anno.domain.special.SpecialRoleUser">
        insert into tb_special_role_user (
        <if test="roleId != null and roleId != 0 ">role_id,</if>
        <if test="userId != null and userId != 0 ">user_id,</if>
        <if test="specialId != null and specialId != '' ">special_id,</if>
        <if test="createBy != null and createBy != '' ">create_by,</if>
        <if test="updateBy != null and updateBy != '' ">update_by,</if>
        create_time,
        update_time
        )values(
        <if test="roleId != null and roleId != 0">#{roleId},</if>
        <if test="userId != null and userId != 0">#{userId},</if>
        <if test="specialId != null and specialId != ''">#{specialId},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
        sysdate(),
        sysdate()
        )
    </insert>

    <update id="updateRole" parameterType="cn.staitech.anno.domain.special.SpecialRoleUser">
        update tb_special_role_user
        <set>
            <if test="roleId != null and roleId != ''">role_id = #{roleId},</if>
            <if test="updateTime != null and updateTime != ''">update_time = #{updateTime},</if>
            update_time = sysdate()
        </set>
        where user_id = #{userId}
        and special_id = #{specialId}
    </update>

    <update id="updateStatus" parameterType="cn.staitech.anno.domain.special.SpecialRoleUser">
        update tb_special_role_user
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null and updateTime != ''">update_time = #{updateTime},</if>
            update_time = sysdate()
        </set>
        where user_id = #{userId}
        and special_id = #{specialId}
        and role_id = #{roleId}
    </update>

    <select id="countSpecialRoleUserByRoleId" resultType="Integer">
        select count(1)
        from tb_special_role_user
        where role_id = #{roleId}
    </select>
</mapper>