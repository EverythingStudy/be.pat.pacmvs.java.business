<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.staitech.anno.mapper.PathologicalIndicatorCategoryMapper">
    <resultMap id="BaseResultMap" type="cn.staitech.anno.domain.PathologicalIndicatorCategory">
        <id column="category_id" jdbcType="BIGINT" property="categoryId"/>
        <result column="indicator_id" jdbcType="BIGINT" property="indicatorId"/>
        <result column="color" jdbcType="VARCHAR" property="color"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="BIGINT" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="category_name" jdbcType="VARBINARY" property="categoryName"/>
        <result column="anno_type" jdbcType="BIGINT" property="annoType"/>
        <result column="order_number" jdbcType="VARCHAR" property="orderNumber"/>
        <result column="number" jdbcType="VARCHAR" property="number"/>
        <result column="del_flag" jdbcType="INTEGER" property="delFlag"/>
    </resultMap>

    <resultMap type="cn.staitech.anno.domain.vo.statistic.StatisticCategoryListOutVO"
               id="SysAnnotationCategoryStatisticResult">
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="color" column="color"/>
        <result property="indicatorId" column="indicator_id"/>
        <result property="indicatorName" column="indicator_name"/>
        <result property="sum" column="sum"/>
    </resultMap>

    <resultMap type="cn.staitech.anno.domain.geojson.GeoLabel" id="GeoLabelResult">
        <result property="label_name" column="label_name"/>
        <result property="label_color" column="label_color"/>
    </resultMap>

    <resultMap id="BaseResult" type="cn.staitech.anno.domain.vo.LabelListVO">
        <id column="category_id" jdbcType="BIGINT" property="categoryId"/>
        <result column="indicator_id" jdbcType="BIGINT" property="indicatorId"/>
        <result column="color" jdbcType="VARCHAR" property="color"/>
        <result column="create_by" jdbcType="BIGINT" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="category_name" jdbcType="VARBINARY" property="categoryName"/>
        <result column="order_number" jdbcType="VARCHAR" property="orderNumber"/>
        <result column="number" jdbcType="VARCHAR" property="number"/>
        <result column="user_name" jdbcType="VARCHAR" property="userName"/>
    </resultMap>

    <sql id="Base_Column_List">
        category_id
        , indicator_id, rgb , hex, structure_id, create_by, create_time, update_by, update_time, category_name,order_number,organization_id,number
    </sql>

    <!--  根据主键查询单条标注信息-->
    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tb_pathological_indicator_category
        where category_id = #{categoryId,jdbcType=BIGINT}
    </select>

    <select id="selectAnnotationCategoryStatisticList" parameterType="java.lang.Integer"
            resultMap="SysAnnotationCategoryStatisticResult">
        select pic.category_id, pic.category_name, pic.color, pi.indicator_id, pi.indicator_name
        from tb_pathological_indicator_category as pic
        left join tb_pathological_indicator as pi on pic.indicator_id = pi.indicator_id
        <where>
            AND pic.category_id != 1
            <if test="indicatorIdList.size() != 0 and indicatorIdList != null ">
                AND pic.indicator_id in
                <foreach collection="indicatorIdList" item="indicatorId" open="(" separator="," close=")">
                    #{indicatorId}
                </foreach>
            </if>
            <if test="projectIdList.size() != 0 and indicatorIdList != null ">
                AND pic.indicator_id in
                (
                select p.indicator_id from tb_project as p
                where p.project_id in
                <foreach collection="projectIdList" item="projectId" open="(" separator="," close=")">
                    #{projectId}
                </foreach>
                )
            </if>
        </where>
        order by pic.indicator_id desc, pic.category_id desc
    </select>

    <!--  根据主键删除单挑标注信息-->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete
        from tb_pathological_indicator_category
        where category_id = #{categoryId,jdbcType=BIGINT}
    </delete>

    <!--添加数据-->
    <insert id="insertSelective" parameterType="cn.staitech.anno.domain.PathologicalIndicatorCategory">
        insert into tb_pathological_indicator_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">
                category_id,
            </if>
            <if test="indicatorId != null">
                indicator_id,
            </if>
            <if test="structureId != null">
                structure_id,
            </if>
            <if test="rgb != null">
                rgb,
            </if>
            <if test="hex != null">
                hex,
            </if>
            <if test="organizationId != null">
                organization_id,
            </if>
            <if test="createBy != null">
                create_by,
            </if>
            create_time,
            <if test="categoryName != null">
                category_name,
            </if>
            <if test="annoType != null">
                anno_type,
            </if>
            <if test="orderNumber != null">
                order_number,
            </if>
            <if test="number != null">
                number,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">
                #{categoryId,jdbcType=BIGINT},
            </if>
            <if test="indicatorId != null">
                #{indicatorId,jdbcType=BIGINT},
            </if>
            <if test="structureId != null">
                #{structureId,jdbcType=VARCHAR},
            </if>
            <if test="rgb != null">
                #{rgb,jdbcType=VARCHAR},
            </if>
            <if test="hex != null">
                #{hex,jdbcType=VARCHAR},
            </if>
            <if test="organizationId != null">
                #{organizationId,jdbcType=BIGINT},
            </if>
            <if test="createBy != null">
                #{createBy,jdbcType=BIGINT},
            </if>
            sysdate(),
            <if test="categoryName != null">
                #{categoryName,jdbcType=VARCHAR},
            </if>
            <if test="annoType != null">
                #{annoType,jdbcType=BIGINT},
            </if>
            <if test="orderNumber != null">
                #{orderNumber,jdbcType=VARCHAR},
            </if>
            <if test="number != null">
                #{number,jdbcType=VARCHAR},
            </if>
        </trim>
    </insert>
    <!--  根据id更新数据-->
    <update id="updateByPrimaryKeySelective" parameterType="cn.staitech.anno.domain.PathologicalIndicatorCategory">
        update tb_pathological_indicator_category
        <set>
            <if test="structureId != null">
                structure_id = #{structureId,jdbcType=VARCHAR},
            </if>
            <if test="rgb != null">
                rgb = #{rgb,jdbcType=VARCHAR},
            </if>
            <if test="hex != null">
                rgb = #{hex,jdbcType=VARCHAR},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy,jdbcType=BIGINT},
            </if>
            update_time = sysdate() ,
            <if test="categoryName != null">
                category_name = #{categoryName,jdbcType=VARCHAR},
            </if>
            <if test="number != null">
                number = #{number,jdbcType=VARCHAR},
            </if>
            <if test="orderNumber != null">
                order_number = #{orderNumber,jdbcType=VARCHAR},
            </if>
            <if test="delFlag != null">
                del_flag = #{delFlag,jdbcType=INTEGER},
            </if>
        </set>
        <where>
            <if test="categoryId != null and categoryId != '' ">
                AND category_id = #{categoryId}
            </if>
            <if test="indicatorId != null and indicatorId != '' ">
                AND indicator_id = #{indicatorId}
            </if>
            <if test="organizationId != null and organizationId != '' ">
                AND organization_id = #{organizationId}
            </if>
        </where>
    </update>

    <select id="selectIndicatorIdAll" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select *
        from tb_pathological_indicator_category
        where indicator_id = #{indicatorId}
           or category_id = 0
           or category_id = 1
        order by order_number desc
    </select>

    <select id="selectIndicatorIdList" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT
            category_name as label_name,
            rgb as label_color
        FROM
            tb_pathological_indicator_category
        WHERE
            indicator_id = 1

    </select>

    <delete id="delIndicatorCategory" parameterType="java.lang.Long">
        delete
        from tb_pathological_indicator_category
        where indicator_id = #{indicatorId}
    </delete>

    <select id="selectCategoryAll" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select *
        from tb_pathological_indicator_category
        where category_id = #{categoryId}
    </select>

    <!-- 结构编码在当前列表内不可重复；C：结构名称在当前列表内不可重复。D：图层顺序在当前列表内不可重复；E：颜色值在当前列表不可重复 -->
    <select id="selectIndicatorMessage" parameterType="cn.staitech.anno.domain.PathologicalIndicatorCategory"
            resultMap="BaseResultMap">
        select * from tb_pathological_indicator_category where del_flag=0
        <if test="indicatorId != null and indicatorId != ''">
            AND indicator_id = #{indicatorId}
        </if>
        <if test="categoryName != null and categoryName != ''">
            AND category_name = #{categoryName}
        </if>
        <if test="categoryId != null and categoryId != ''">
            AND category_id = #{categoryId}
        </if>
        <if test="organizationId != null">
            AND organization_id = #{organizationId}
        </if>
        <if test="number != null and number != ''">
            OR number = #{number}
        </if>
        <if test="rgb != null">
            OR rgb = #{rgb}
        </if>
        <if test="hex != null">
            OR hex = #{hex}
        </if>
        <if test="structureId != null">
            OR structure_id = #{structureId}
        </if>
        <if test="orderNumber != null and orderNumber != ''">
            OR order_number = #{orderNumber}
        </if>

    </select>

    <select id="selectByProjectId" parameterType="java.lang.Long" resultMap="SysAnnotationCategoryStatisticResult">
        select DISTINCT a.category_id, i.category_name, sum(a.sum) as sum
        from tb_slide_annotation_result as a left join tb_slide as s
        on a.slide_id =s.slide_id left join tb_pathological_indicator_category as i
            on i.category_id=a.category_id
        where s.project_id=#{projectId}
        group by a.category_id
        order by sum desc
    </select>

    <!--通过项目ID查询标注类别-->
    <select id="selectCategoryByProjectId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT p.indicator_id,
               pic.category_id,
               pic.category_name,
               pic.create_by
        FROM tb_project p
                 LEFT JOIN tb_pathological_indicator_category pic ON pic.indicator_id = p.indicator_id
        WHERE p.project_id = #{projectId}
    </select>

    <select id="selectCategoryNumber" parameterType="java.lang.Long" resultType="java.lang.Integer">
        select count(*)
        from tb_pathological_indicator_category
        where indicator_id = #{indicatorId}
          and del_flag = 0
    </select>

    <select id="selectProjectCategory" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT i.category_name, i.category_id
        FROM `tb_pathological_indicator_category` as i
                 left join tb_project as p
                           on i.indicator_id = p.indicator_id
        where p.project_id = #{projectId}
    </select>

    <select id="selectByIndicator" parameterType="cn.staitech.anno.domain.vo.LabelVO" resultMap="BaseResult">
        select
        p.indicator_id,p.category_name,p.category_id,p.structure_id,p.rgb,p.hex,p.create_by,p.create_time,p.order_number,s.user_name,p.number,p.organization_id,st.name
        as structure_name
        from tb_pathological_indicator_category as p
        left join sys_user as s on p.create_by=s.user_id
        left join tb_structure as st on p.structure_id=st.structure_id
        <where>
            <if test="categoryName != null and categoryName != ''">
                AND p.category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="organizationId != null">
                AND p.organization_id =#{organizationId}
            </if>
            <if test="structureId != null">
                AND p.structure_id =#{structureId}
            </if>
            <if test="structureName != null and structureName != ''">
                AND p.structure_name like concat('%', #{structureName}, '%')
            </if>
            <if test="params != null">
                <if test="createTimeParams.beginTime != null and createTimeParams.beginTime != ''"><!-- 开始时间检索 -->
                    AND date_format(p.create_time,'%y%m%d') &gt;= date_format(#{createTimeParams.beginTime},'%y%m%d')
                </if>
                <if test="createTimeParams.endTime != null and createTimeParams.endTime != ''"><!-- 结束时间检索 -->
                    AND date_format(p.create_time,'%y%m%d') &lt;= date_format(#{createTimeParams.endTime},'%y%m%d')
                </if>
            </if>
            and p.del_flag=0
        </where>
    </select>

    <select id="selectLabelNum" parameterType="java.lang.Long" resultType="java.lang.Integer">
        select count(*)
        from tb_special_annotation
        where category_id = #{categoryId}
    </select>

</mapper>